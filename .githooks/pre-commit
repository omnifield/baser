#!/bin/sh
# Машинный pre-commit. Рамка требует зелёный test+lint+build перед коммитом, и это
# ТРЕБОВАНИЕ К ПРОДУКТУ: git-хуки — наша территория, обвес их не везёт (kb:BRAIN2-64,
# заявка tasker:BRAIN2-52 — она же и уточнила формулировку рамки).
#
# До 2026-08-02 машины не было вовсе, а рамка обещала её текстом: каденс держался на
# дисциплине агентов. Дисциплина держала, но обещание в доке — такой же контракт, как код.
#
# Готовность монорепы — ОДНА команда: `pnpm verify` гоняет test + typecheck + build
# по всей монорепе без кэша (~15 с). Зона зелёная в одиночку ничего не доказывает —
# общая форма ломает соседей, а не себя.
set -e
pnpm verify

# Вторая команда — не вторая готовность, а зона, которой первая не видит ПО
# ПОСТРОЕНИЮ. Обвязка репозитория живёт в `.github`, а nx и корневой
# `vitest.workspace.ts` dot-каталоги не обходят (проверено 2026-08-05). Раньше
# кода в зоне не было и вопрос не стоял; теперь есть — и правило заголовка PR
# держится пробами, а не живым прогоном на живом PR (`tasker:BASER2-167`, -184).
exec pnpm exec vitest run --config .github/vitest.config.mts
