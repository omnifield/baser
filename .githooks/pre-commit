#!/bin/sh
# Машинный pre-commit. Рамка требует зелёный test+lint+build перед коммитом, и это
# ТРЕБОВАНИЕ К ПРОДУКТУ: git-хуки — наша территория, обвес их не везёт (kb:BRAIN2-64,
# заявка tasker:BRAIN2-52 — она же и уточнила формулировку рамки).
#
# До 2026-08-02 машины не было вовсе, а рамка обещала её текстом: каденс держался на
# дисциплине агентов. Дисциплина держала, но обещание в доке — такой же контракт, как код.
#
# Готовность монорепы — ОДНА команда: `pnpm verify` гоняет test + typecheck + build
# по всей монорепе без кэша (~35 с). Зона зелёная в одиночку ничего не доказывает —
# общая форма ломает соседей, а не себя.
#
# ОДНА, А НЕ ДВЕ. До `tasker:BASER2-167` зона `git` гонялась второй командой:
# `vitest run --project git-pipeline` отвечал «no projects matched», и отсюда было
# выведено, что корневой обход пропускает dot-каталоги. Наблюдение верное, вывод —
# нет: проектов не находилось НИ ОДНОГО, потому что перечислял их `vitest.workspace.ts`,
# а vitest 4 этот файл не читает (`tasker:BASER2-191`, разбор 2026-08-06; файл удалён).
# Dot-каталоги корневой обход как раз берёт — `vitest list` из корня называет
# `.github/scripts/*.spec.mjs`. Пробы зоны бегут внутри `verify` по другой причине:
# у неё свой `project.json`, и nx видит её проектом. Вторая команда держалась на
# том, что о ней помнят; эта — нет.
#
# ЭТУ ЖЕ команду зовёт приёмка на потоке (`.github/workflows/ci.yml`) — иначе
# вахтёр и приёмка гоняют разное, и зелёное здесь ничего не обещает там.
set -e
exec pnpm verify
