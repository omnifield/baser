{
  // baser-devbox — Ф2 (kb:ADR-16 volume-workspace, kb:FUND-4 containers-only).
  // ГРИНФИЛД на стандартном Dev Containers (adopt-not-invent, kb:ADR-20): upstream-образ +
  // features + native "Clone Repository in Container Volume". БЕЗ skeleton-скриптов
  // (devbox.sh/-manifest/-session/-services) и БЕЗ biome/GH-Packages — это devopser-legacy.
  // Docker-инварианты канон-чистого девбокса сохранены (kb:DEVOPSER-3).
  "name": "baser-devbox",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "remoteUser": "node",

  // Сеть omnifield-gateway создаётся ДО контейнера и НА ХОСТЕ: войти в несуществующую сеть
  // докер не даёт, и первый девбокс на чистой машине без этой строки не встаёт. Команда
  // идемпотентна — сеть уже есть, значит не сделано ничего. Внутри контейнера здесь ещё
  // нет ничего: его самого нет.
  "initializeCommand": "docker network create omnifield-gateway 2>/dev/null || true",

  // Канон-чистые инварианты (kb:DEVOPSER-3): peer-alias в общей сети omnifield-gateway
  // (видят tasker/knowledger по имени), host-gateway, НОЛЬ host-портов (single-origin —
  // наружу только дверь :8080; verdaccio :4873 остаётся внутренним), контейнер переживает
  // рестарт демона.
  "runArgs": [
    "--network=omnifield-gateway",
    "--network-alias=baser",
    "--add-host=host.docker.internal:host-gateway",
    "--restart=unless-stopped"
  ],

  // Переменные окружения контейнера: секрет-модель, адрес pnpm-стора.
  // Секрет-модель (kb:FUND-4): креды/кэши — в named-volume'ах, ENV указывает в /home/node/.secrets.
  // Ничего не хардкодим в образ/репо; тома переживают recreate.
  // Стор pnpm назван ДВУМЯ именами, и это не дубль: до pnpm 11 он читает npm-конфиг
  // (NPM_CONFIG_*), с 11-й — свой (PNPM_CONFIG_*). Без них при воркспейсе-томе pnpm
  // кладёт стор рядом с воркспейсом, а смонтированный том стоит нетронутым.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.secrets/claude",
    "GIT_CONFIG_GLOBAL": "/home/node/.secrets/gitconfig",
    "GH_CONFIG_DIR": "/home/node/.secrets/gh",
    "NPM_CONFIG_USERCONFIG": "/home/node/.secrets/npmrc",
    "NPM_CONFIG_STORE_DIR": "/home/node/.pnpm-store",
    "PNPM_CONFIG_STORE_DIR": "/home/node/.pnpm-store"
  },

  // Фичи Dev Containers — настройка devcontainerFeatures. Базовый образ несёт node/pnpm/git
  // (версия pnpm — из пина самого репозитория через corepack; образ = тонкая оболочка),
  // остальные тулчейны приезжают сюда: чего тут нет, того в девбоксе нет, и постсоздание
  // говорит об этом вслух, если репозиторий тулчейн объявил.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Общие на машине named-volume'ы (одни креды/стор на все omnifield-девбоксы), переживают recreate.
  // Workspace-ТОМ здесь НЕ объявляем: им управляет "Clone Repository in Container Volume"
  // (kb:ADR-16) — VS Code сам создаёт том, клонирует репо, монтирует как workspace. См. runbook.
  "mounts": [
    "source=omnifield-secrets,target=/home/node/.secrets,type=volume",
    "source=omnifield-pnpm-store,target=/home/node/.pnpm-store,type=volume"
  ],

  "customizations": {
    "vscode": {
      // Расширения и форматтер — настройки обвеса. Дополняют .vscode/extensions.json репо.
      "extensions": ["esbenp.prettier-vscode", "nrwl.angular-console"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // Одноразовая (per-volume) цепочка: corepack→pnpm-пин + инструменты локации
  // (настройка globalTools; kb:FUND-4 — исполнение и ассистент живут В контейнере,
  // не на хосте). Версия каждого названа значением, а не подразумевается.
  // ШАГИ НАЗВАНЫ (kb:WORLD-50): каждый объявляет себя строкой «[devbox] шаг N/M …»,
  // а отказ называет шаг, на котором встали, и отдаёт его код. Шаги: пин пакетного менеджера, инструменты локации, фиксация редакций инструментов.
  "onCreateCommand": "devbox_step() { devbox_at=\"$1\"; printf '%s\\n' \"[devbox] шаг $1\" >&2; } && devbox_stop() { devbox_code=$?; printf '%s\\n' \"[devbox] ОТКАЗ на шаге $devbox_at (код $devbox_code)\" >&2; exit \"$devbox_code\"; } && { devbox_step '1/3 corepack — пин пакетного менеджера'; ( sudo corepack enable ); } || devbox_stop && { devbox_step '2/3 tools — инструменты локации'; ( env -u NPM_CONFIG_STORE_DIR npm install -g @anthropic-ai/claude-code@latest ); } || devbox_stop && { devbox_step '3/3 editions — фиксация редакций инструментов'; ( env -u NPM_CONFIG_STORE_DIR node -e 'const d=JSON.parse(process.argv[1]);const r=require(\"child_process\").spawnSync(\"npm\",[\"ls\",\"-g\",\"--depth=0\",\"--json\"],{encoding:\"utf8\"});const got=JSON.parse(r.stdout||\"{}\").dependencies||{};const out={};for(const n of Object.keys(d))out[n]={declared:d[n],version:(got[n]||{}).version||null};const lost=Object.keys(out).filter((n)=>!out[n].version);if(lost.length){process.stderr.write(\"[devbox] Фиксация редакций: \" + lost.join(\", \") + \" объявлен табличкой, а в машине его нет — записывать нечего.\\n\");process.exit(1);}require(\"fs\").writeFileSync(process.argv[2],JSON.stringify({globalTools:out},null,2)+\"\\n\");' '{\"@anthropic-ai/claude-code\":\"latest\"}' \"${HOME:-/home/node}/.devbox-editions.json\" ); } || devbox_stop",

  // Репо-зависимая цепочка, шаги названы так же: названные потери тулчейна, права на общие тома, seed claude-онбординга, проверка доступа к реестру, установка зависимостей.
  "postCreateCommand": "devbox_step() { devbox_at=\"$1\"; printf '%s\\n' \"[devbox] шаг $1\" >&2; } && devbox_stop() { devbox_code=$?; printf '%s\\n' \"[devbox] ОТКАЗ на шаге $devbox_at (код $devbox_code)\" >&2; exit \"$devbox_code\"; } && { devbox_step '1/5 toolchain — названные потери тулчейна'; ( ( lost=; if { [ -f uv.lock ] || grep -qs '^\\[tool.uv\\]' pyproject.toml; } && ! { command -v uv >/dev/null 2>&1; }; then printf '%s\\n' '[devbox] Репозиторий объявляет uv (uv.lock, [tool.uv] в pyproject.toml), а команды uv в девбоксе нет.' >&2; lost=1; fi; if { { [ -f .python-version ] || [ -f pyproject.toml ]; } && ! { [ -f uv.lock ] || grep -qs '^\\[tool.uv\\]' pyproject.toml; }; } && ! { command -v python >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; }; then printf '%s\\n' '[devbox] Репозиторий объявляет питон (.python-version, pyproject.toml), а ни одной из команд python, python3 в девбоксе нет.' >&2; lost=1; fi; if { [ -f go.mod ]; } && ! { command -v go >/dev/null 2>&1; }; then printf '%s\\n' '[devbox] Репозиторий объявляет go (go.mod), а команды go в девбоксе нет.' >&2; lost=1; fi; if [ -n \"$lost\" ]; then printf '%s\\n' '[devbox] Девбокс НОДОВЫЙ: базовый образ несёт node/pnpm/git, остальные тулчейны приезжают фичами Dev Containers.' '[devbox] Добавь нужные настройкой devcontainerFeatures в файле настроек девбокса и пересоздай контейнер.' '[devbox] Каталог фич: https://containers.dev/features' '[devbox] Пока их нет — таргеты этого тулчейна упадут, и обычно первым же git commit.' >&2 ; fi ) ); } || devbox_stop && { devbox_step '2/5 volumes — права на общие тома'; ( sudo chown -R node:node /home/node/.secrets /home/node/.pnpm-store ); } || devbox_stop && { devbox_step '3/5 assistant — seed claude-онбординга'; ( mkdir -p \"$CLAUDE_CONFIG_DIR\" && { [ -f \"$CLAUDE_CONFIG_DIR/.claude.json\" ] || printf '%s\\n' '{\"hasCompletedOnboarding\":true,\"hasTrustDialogAccepted\":true,\"theme\":\"dark\"}' > \"$CLAUDE_CONFIG_DIR/.claude.json\"; } ); } || devbox_stop && { devbox_step '4/5 registry — проверка доступа к реестру'; ( ( reg=$(env -u NPM_CONFIG_STORE_DIR pnpm config get @omnifield:registry); case \"$reg\" in http*) ;; *) printf '%s\\n' '[devbox] Пакеты @omnifield/* тянутся из приватного реестра, а он не настроен.' '[devbox] Установка пойдёт в npmjs.org и ответит «404, пакета нет» — хотя пакет есть, нет доступа.' '[devbox] Настрой доступ в /home/node/.secrets/npmrc — том, переживает пересоздание контейнера:' '[devbox]   npm config set @omnifield:registry <адрес-реестра> --location=user' '[devbox]   npm config set //<хост-реестра>/:_authToken <токен> --location=user' >&2 ; exit 1;; esac; h=${reg#*://}; h=${h%/}; env -u NPM_CONFIG_STORE_DIR pnpm whoami --registry=\"$reg\" >/dev/null 2>&1 || { printf '%s\\n' '[devbox] Реестр для @omnifield настроен, а доступа к нему нет: токен не положен или протух.' \"[devbox]   реестр: $reg\" \"[devbox]   проверка руками: pnpm whoami --registry=$reg\" '[devbox] Положи токен в /home/node/.secrets/npmrc — том, переживает пересоздание контейнера:' \"[devbox]   npm config set //$h/:_authToken <токен> --location=user\" >&2 ; exit 1; } ) ); } || devbox_stop && { devbox_step '5/5 install — установка зависимостей'; ( if [ -f package.json ]; then pnpm install --frozen-lockfile --config.confirmModulesPurge=false; else printf '%s\\n' '[devbox] package.json в корне нет — ставить нечего, установка зависимостей пропущена.' '[devbox] Локация не на ноде — задай свою команду настройкой installCommand, она поедет как написана.' >&2; fi ); } || devbox_stop"
}
