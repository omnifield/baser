{
  "name": "@omnifield/baser-cli",
  "version": "0.9.0-dev.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnifield/baser.git",
    "directory": "packages/baser-cli"
  },
  "description": "Консоль baser: зовёт станок и кладёт обвес на диск — план называет движение до применения",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "baser": "./dist/bin/baser.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@omnifield/baser-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@omnifield/baser-check": "workspace:*",
    "@omnifield/baser-contracts": "workspace:*",
    "@omnifield/baser-materialize": "workspace:*",
    "@omnifield/baser-pack": "workspace:*",
    "ejs": "^5.0.1",
    "tslib": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nx/devkit": "23.1.0",
    "@types/ejs": "^3.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "{workspaceRoot}/.devcontainer/**/*",
        "{workspaceRoot}/baser.json",
        "{workspaceRoot}/baser.lock.json",
        "{workspaceRoot}/.omnifield/omnifield-devbox.yaml",
        "{workspaceRoot}/packages/baser-devbox/**/*"
      ]
    }
  }
}
