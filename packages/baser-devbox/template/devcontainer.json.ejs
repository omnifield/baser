<%
// Слой «настройки» собирается здесь, чтобы ниже читался готовый devcontainer.

// ПОЛЬЗОВАТЕЛЬ ОБРАЗА — ОДИН ИСТОЧНИК ДЛЯ ВСЕГО, ЧТО ОТ НЕГО СЧИТАЕТСЯ.
//
// До 0.4.0 он был прибит к `node` в пяти местах сразу — `remoteUser`, цели томов,
// `containerEnv`, `chown`, текст про креды, — а настройка `image` при этом обещала
// поставить чужой образ. Обещание держалось только для образов, где пользователя
// зовут `node`: у живого девбокса weber он `vscode`, и тома с переменными уехали бы
// в несуществующий домашний каталог, а `chown` упал бы (tasker:BASER2-40).
// Половина настройки хуже её отсутствия (kb:BASER2-2 §5), поэтому источник один.
//
// ДОМАШНИЙ КАТАЛОГ БЕРЁТСЯ ПО СОГЛАШЕНИЮ, и это названная граница, а не догадка:
// `/root` у root, `/home/<имя>` у остальных. Спросить образ обвес не может — он
// кладёт файл, а не запускает контейнер, — а цель тома обязана быть литералом:
// `mounts` разворачивается docker'ом до того, как внутри контейнера существует
// хоть какая-то `$HOME`. Образ, кладущий пользователя иначе, этой настройкой не
// покрыт, и так сказано в её описании.
const home = imageUser === 'root' ? '/root' : `/home/${imageUser}`;
// Группа — одноимённая с пользователем: так его заводят upstream-образы Dev
// Containers (`node`, `vscode`, `codespace`), так же устроен и root.
const owner = `${imageUser}:${imageUser}`;

// НАЗВАННЫЙ ОТКАЗ ОБВЕСА. Своего кода у него нет — коды называет форма, — поэтому
// прогон получает `render-failed` с НАШИМ текстом, и на диск не ложится ничего.
// Это единственный канал, которым инструмент говорит «так нельзя» до применения.
const refuse = (message) => {
  throw new Error(`[devbox] ${message}`);
};

// СТОР PNPM: том мало смонтировать, в него надо ЗАВЕСТИ pnpm.
//
// Настройка монтировала том — и всё. При воркспейсе-томе («Clone Repository in
// Container Volume», kb:ADR-16) pnpm держит стор на файловой системе САМОГО
// воркспейса ради хардлинков, дефолт `~/.local/share/pnpm/store` отбрасывается,
// и стор уезжает внутрь воркспейс-тома. Замерено на живом переезде
// (tasker:BASER2-111): том 310M не тронут с 25.07, реальный стор — 355M внутри
// /workspaces. То есть настройка обещала «общий на машине стор, переживающий
// пересоздание», а давала ровно обратное — смертный стор внутри воркспейса.
//
// Половина имитации хуже её отсутствия (kb:BASER2-2 §5), поэтому из трёх выходов
// — направить pnpm · снять настройку · сказать в плане — выбран первый: том уже
// смонтирован, оставалось направить туда pnpm. Делается это ниже, переменными
// окружения, а не `pnpm config set` в постсоздании: конфиг pnpm при томе кредов
// лёг бы в ЧУЖОЙ том (NPM_CONFIG_USERCONFIG указывает в него), то есть один
// девбокс писал бы настройку всем остальным.
//
// ── АДРЕС ТОМА — НАШ, И ЭТО ПОЧИНКА НАШЕЙ ЖЕ РЕГРЕССИИ ──────────────────────
//
// Сначала том встал по адресу pnpm-по-умолчанию — `~/.local/share/pnpm/store`,
// то есть ВНУТРЬ общего XDG-каталога данных. Докер создаёт цепочку каталогов до
// точки монтирования САМ и создаёт её от root, а постсоздание правит права
// только на сам том. Через час у потребителя это выглядело так
// (tasker:BASER2-114 Н2, tasker:BASER2-115):
//
//   drwxr-xr-x 3 root root  /home/node/.local/share       ← создан докером
//   drwxr-xr-x 4 node node  /home/node/.local/share/pnpm/store  ← только это наше
//   $ uv run ruff check .
//   error: failed to create directory `/home/node/.local/share/uv/python`: Permission denied
//
// Ляжет так ЛЮБОЙ инструмент, кладущий данные в `~/.local/share/<имя>`, — а это
// стандартный адрес, туда пишут почти все. Чинится это не chown'ом по цепочке:
// правь мы права, каталог всё равно оставался бы захвачен нами ради ОДНОГО
// инструмента, и следующий сосед упирался бы в следующий такой же захват.
// Ошибка была не в правах, а в том, что мы въехали в общий каталог.
//
// Поэтому адрес тома теперь СВОЙ и лежит прямо в доме: между домом и точкой
// монтирования нет ни одного каталога, который докер создал бы от root. Правило
// общее для всех томов обвеса и держится пробой, а не внимательностью.
const storeDir = pnpmStoreVolume ? `${home}/.pnpm-store` : null;

const mounts = [];
if (secretsVolume) mounts.push(`source=${secretsVolume},target=${home}/.secrets,type=volume`);
if (storeDir) mounts.push(`source=${pnpmStoreVolume},target=${storeDir},type=volume`);
const mountTargets = mounts.map((m) => m.split(',')[1].slice('target='.length));

// ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ КОНТЕЙНЕРА: три источника и один запрет.
//
// Считанное обвесом (секрет-модель от `secretsVolume`, адрес стора от
// `pnpmStoreVolume`) продуктовым слоем НЕ перекрывается: значения выведены из
// других настроек, и «победил последний» здесь означал бы девбокс, у которого
// креды ищутся не там, где лежат. Столкновение — названный отказ (tasker:BASER2-107).
const env = new Map();
if (secretsVolume) {
  env.set('CLAUDE_CONFIG_DIR', `${home}/.secrets/claude`);
  env.set('GIT_CONFIG_GLOBAL', `${home}/.secrets/gitconfig`);
  env.set('GH_CONFIG_DIR', `${home}/.secrets/gh`);
  env.set('NPM_CONFIG_USERCONFIG', `${home}/.secrets/npmrc`);
}
if (storeDir) {
  // ДВА ИМЕНИ ОДНОГО ЗНАЧЕНИЯ — не дубль, а две линии pnpm: до 11-й он читает
  // npm-конфиг (`NPM_CONFIG_*`), с 11-й — свой (`PNPM_CONFIG_*`), и каждая линия
  // чужое имя игнорирует. Замерено обеими (10.11.0 и 11.9.0), а не выведено из
  // доки: назвать одно имя значило бы починить стор ровно половине потребителей.
  env.set('NPM_CONFIG_STORE_DIR', storeDir);
  env.set('PNPM_CONFIG_STORE_DIR', storeDir);
}

// Продуктовые переменные приезжают КАРТОЙ (форма 3, kb:BASER2-23), и разбирать
// здесь больше нечего: пара «имя → значение» это и есть предмет настройки, а не
// строка, которую надо резать по первому знаку равенства. Вместе с разбором ушли
// два отказа, которые он же и порождал: «строка не в форме КЛЮЧ=значение» (форма
// такого значения теперь не принимает вовсе) и «ключ задан дважды» (повтор ключа
// отвергает разборщик YAML — карта ловит его даром).
const computedEnv = new Set(env.keys());
const source = (key) => (key.endsWith('_STORE_DIR') ? 'pnpmStoreVolume' : 'secretsVolume');
for (const [key, value] of Object.entries(extraContainerEnv ?? {})) {
  // Имя переменной формой не проверяется и проверяться не может: ключ карты это
  // строка, а годность её в имя переменной окружения — знание шелла, то есть
  // наше. `2FA=on` контейнер бы не принял, и узнать об этом лучше здесь.
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
    refuse(
      `настройка extraContainerEnv: "${key}" не годится в имя переменной окружения ` +
        '(буквы, цифры и подчёркивание; первым символом не цифра)',
    );
  }
  if (computedEnv.has(key)) {
    refuse(
      `настройка extraContainerEnv переопределяет ${key}, а его обвес считает сам ` +
        `от настройки ${source(key)} (${env.get(key)}). Продуктовым слоем это значение не ` +
        'перекрывается: убери ключ из extraContainerEnv или сними настройку, которая его задаёт',
    );
  }
  env.set(key, value);
}

const runArgs = [];
if (network) runArgs.push(`--network=${network}`, `--network-alias=${networkAlias}`);
runArgs.push('--add-host=host.docker.internal:host-gateway', '--restart=unless-stopped');

// Настройки редактора. Форматтер — РЕГУЛИРОВКА, а не константа: прибитый гвоздями,
// он заставляет потребителя с другим стеком форкать обвес целиком из-за одной строки,
// и это дефект шаблона, а не проблема пользователя (kb:BASER2-2 §5).
// Не задан вовсе (null) — обвес форматирование не навязывает и обе строки не кладёт.
const editorSettings = [];
if (editorFormatter) {
  editorSettings.push('"editor.formatOnSave": true');
  editorSettings.push(`"editor.defaultFormatter": ${JSON.stringify(editorFormatter)}`);
}
// tsdk регулировкой НЕ становится: он указывает на TypeScript САМОГО репозитория, и для
// devbox-образа typescript-node другого верного значения нет.
editorSettings.push('"typescript.tsdk": "node_modules/typescript/lib"');

// ЗАДАННЫЙ ФОРМАТТЕР ОБВЕС ДЕРЖИТ В СПИСКЕ РАСШИРЕНИЙ САМ.
//
// `editor.defaultFormatter` принимает ИДЕНТИФИКАТОР РАСШИРЕНИЯ, поставляющего
// форматтер. Значит «форматтер задан» и «расширение стоит» — одно и то же
// утверждение, и обвес может гарантировать его по построению, а не называть отказом:
// отказ требовал бы действия от человека там, где верный ответ обвесу известен.
// Так класс ошибки (форматтер, которого в контейнере нет) исчезает, а не ловится.
//
// ИСКЛЮЧЕНИЕ — встроенные расширения. Издатель `vscode.` зарезервирован за теми, что
// уже в редакторе (`vscode.json-language-features` и прочие). Их не ставят из
// маркетплейса, и запись в `extensions` для них — не «на всякий случай», а
// несуществующий идентификатор в артефакте, то есть та же тихая неверность с другой
// стороны. Условие сужает правило, а не отменяет: чинить по построению — значит не
// чинить одно, ломая соседнее.
const builtInFormatter = Boolean(editorFormatter) && editorFormatter.startsWith('vscode.');
const injectedFormatter =
  Boolean(editorFormatter) && !builtInFormatter && !editorExtensions.includes(editorFormatter);
const extensions = injectedFormatter ? [...editorExtensions, editorFormatter] : editorExtensions;

// ФИЧИ DEV CONTAINERS — настройка, а не список, прибитый в шаблоне.
//
// Спека девконтейнеров решает тулчейн именно фичами, и шаблон ими уже
// пользовался — но список был прибит, и полиглот-репозиторий не мог добавить
// себе питон, не форкнув обвес из-за одной строки (tasker:BASER2-110). Это ровно
// тот дефект шаблона, что и прибитый форматтер: отсутствие регулировки под
// ходовую нужду — наш брак, а не выбор пользователя (kb:BASER2-7).
//
// Форма — КАРТА «ссылка → опции» (форма 3, kb:BASER2-23), и это второй заход:
// списком строк опции фичи не выражались никак, кроме изобретения словаря внутри
// строки (`ref?version=0.11`). Цена была живой — brainer пинует uv, а фича без
// опций привозит latest: инструмент появился бы, а каденс не ожил (BASER2-116).
//
// Ушла вместе со списком и проверка повтора: у карты одинаковых ключей не бывает
// по построению — разборщик YAML отвергает их сам. Ручная проверка была ценой
// того, что форма не выражала предмет; предмет выражен — цена не нужна.
const features = devcontainerFeatures ?? {};
for (const ref of Object.keys(features)) {
  if (ref.trim() === '') {
    refuse('настройка devcontainerFeatures: пустой ключ — ссылка на фичу это адрес, а не пустое место');
  }
}

// Обе проверки постсоздания говорят одним голосом: строка с ярлыком `[devbox]` в
// stderr. Помощники объявлены здесь, потому что ими пользуются обе.
const say = (...args) => `printf '%s\\n' ${args.join(' ')} >&2`;
const q = (line) => `'[devbox] ${line}'`;

// СТОР — ДЕЛО УСТАНОВКИ ЗАВИСИМОСТЕЙ, И БОЛЬШЕ НИЧЬЁ.
//
// `NPM_CONFIG_STORE_DIR` заведён ради pnpm ниже 11-й линии: она читает
// npm-конфиг, и другого имени у неё нет. npm такого имени не знает и печатает на
// КАЖДЫЙ свой вызов:
//
//   npm warn Unknown env config "store-dir".
//   This will stop working in the next major version of npm.
//
// Пока имя стоит в `containerEnv`, его видит любая команда контейнера — включая
// наши собственные. Потребитель на пересоздании получал это предупреждение
// дважды подряд, обоими вызовами НАШЕЙ проверки реестра, и читал его как «что-то
// не так с реестром» (`tasker:BASER2-136`). Обвес спотыкался о то, что сам же и
// поставил.
//
// Чинится это не молчанием предупреждения, а АДРЕСОМ переменной: стор нужен ровно
// установке зависимостей, она его и получает — из `containerEnv`, как раньше. Все
// прочие команды обвеса идут без него, и правило это проверяемое, а не список
// исключений: «нужен ли этой команде стор» знает шаблон, а «кто из менеджеров
// внутри окажется npm» — нет. Знать и не надо: pnpm до 11-й линии отдаёт `whoami`
// npm'у (`passThruToNpm` в её же исходнике), то есть предупреждение приезжало бы
// оттуда даже там, где мы зовём pnpm.
//
// `PNPM_CONFIG_STORE_DIR` снимать не с чего: своё имя pnpm знает обе линии, и
// молчат обе.
const noStore = (command) =>
  storeDir ? `env -u NPM_CONFIG_STORE_DIR ${command}` : command;

// ЧЕГО ДЕВБОКС НЕ ДАЁТ — НАЗЫВАЕТСЯ ВСЛУХ.
//
// «Девбокс» у нас сегодня значит «НОДОВЫЙ девбокс»: базовый образ несёт
// node/pnpm/git, всё прочее приезжает фичами. Нигде не написанное, это
// обнаруживалось самым дорогим способом — первым `git commit`: репозиторий
// brainer объявляет питон в корне (`.python-version`, `[tool.uv]`, `uv.lock`), его
// nx-таргеты зовут `uv`, а `uv` в девбоксе нет — pre-commit упал на трёх зонах
// сразу, и коммит-каденс продукта встал целиком (tasker:BASER2-109 П1).
//
// Обвес не обязан нести все тулчейны мира — но обязан НАЗВАТЬ расхождение, и
// назвать его фактом с двух концов: объявил ли ТУЛЧЕЙН САМ РЕПОЗИТОРИЙ (файл в
// корне) и есть ли КОМАНДА в контейнере. Отсюда два свойства: проверка молчит у
// того, кто про этот тулчейн не говорил, и замолкает сама, как только нужную
// фичу добавили. Ни списка «поддерживаемых стеков», ни настройки-выключателя:
// нечего выключать там, где нечего и сказать.
//
// ── СПРАШИВАТЬ НАДО ПРО ТО, ЧЕМ РЕПОЗИТОРИЙ СОБИРАЕТСЯ ЗАПУСКАТЬ ────────────
//
// Первая редакция спрашивала `command -v python` у всякого, кто объявил питон, —
// и кричала у того, кто сделал ВСЁ ПРАВИЛЬНО (tasker:BASER2-117). При модели uv
// питона в PATH нет и быть не должно: `uv` поднимает CPython сам по
// `.python-version` и держит его при проекте. Признак «репозиторий объявил
// питон» был верен, признак «питона нет» — нет.
//
// Цена ложного срабатывания выше пропущенного: предупреждение, которое звучит у
// правого, обесценивает себя — его перестают читать, и оно перестаёт работать
// там, где нужно. Поэтому спрашиваем не «есть ли ЭТА команда», а «есть ли ЧЕМ
// запускать»: у тулчейна список команд, и любой из них достаточно, а объявленный
// uv снимает вопрос про питон целиком — он и есть ответ на него.
const uvDeclared = "[ -f uv.lock ] || grep -qs '^\\[tool.uv\\]' pyproject.toml";
const toolchains = [
  {
    what: 'uv',
    declaredBy: 'uv.lock, [tool.uv] в pyproject.toml',
    when: uvDeclared,
    tools: ['uv'],
  },
  {
    // Вопрос про питон задаётся, только когда на него не ответил uv. И отвечает
    // на него любая из двух команд: репозиторий на системном питоне зовёт
    // `python3`, а `python` есть не в каждом образе — требовать именно его
    // значило бы спрашивать про имя, а не про наличие рантайма.
    what: 'питон',
    declaredBy: '.python-version, pyproject.toml',
    when: `{ [ -f .python-version ] || [ -f pyproject.toml ]; } && ! { ${uvDeclared}; }`,
    tools: ['python', 'python3'],
  },
  // go идёт рядом с питоном не по симметрии: следующие три переезжающих продукта
  // (tasker, knowledger, chater) — все на Go, и класс у них тот же самый.
  {
    what: 'go',
    declaredBy: 'go.mod',
    when: '[ -f go.mod ]',
    tools: ['go'],
  },
];
const missing = (tools) =>
  tools.length > 1
    ? `ни одной из команд ${tools.join(', ')} в девбоксе нет`
    : `команды ${tools[0]} в девбоксе нет`;
const toolchainCheck = [
  '( lost=;',
  ...toolchains.map((chain) =>
    `if { ${chain.when}; } && ! { ${chain.tools.map((tool) => `command -v ${tool} >/dev/null 2>&1`).join(' || ')}; }; then ` +
    `${say(q(`Репозиторий объявляет ${chain.what} (${chain.declaredBy}), а ${missing(chain.tools)}.`))}; lost=1; fi;`,
  ),
  'if [ -n "$lost" ]; then',
  say(
    q('Девбокс НОДОВЫЙ: базовый образ несёт node/pnpm/git, остальные тулчейны приезжают фичами Dev Containers.'),
    q('Добавь нужные настройкой devcontainerFeatures в файле настроек девбокса и пересоздай контейнер.'),
    q('Каталог фич: https://containers.dev/features'),
    q('Пока их нет — таргеты этого тулчейна упадут, и обычно первым же git commit.'),
  ),
  '; fi )',
].join(' ');

// Куда человеку класть креды. Путь настоящий, а не «куда-нибудь»: обещание в тексте
// отказа — такой же контракт, как код, и непроверенное оно заводит в тупик.
const npmrc = secretsVolume
  ? `${home}/.secrets/npmrc — том, переживает пересоздание контейнера`
  : '~/.npmrc — ВНИМАНИЕ: не переживёт пересоздание контейнера, заведи том с кредами';

// Проверка доступа к приватному реестру ДО установки зависимостей.
// Без неё npm идёт в npmjs.org и отвечает «404, пакета нет» — человек идёт искать
// несуществующий пакет вместо своих кредов. Стена без указателя.
//
// УСЛОВИЙ ДВА, И ОНИ ПРО РАЗНОЕ: есть ли у репозитория scope (`npmScope`) и лежит
// ли он в приватном реестре (`npmScopeIsPrivate`). Раньше состояние было одно —
// «scope задан» — и «публичный scope» выражался ОТСУТСТВИЕМ значения, то есть
// неотличимо от «про scope забыли» (`tasker:BASER2-105`). Цена этой неразличимости
// назначена: в день, когда @omnifield станет публичным (`kb:ADR-19`), пин в
// user-конфиге перестанет быть нужен, `npm config get` вернёт `undefined` — и
// проверка уронила бы ПРАВИЛЬНО настроенный девбокс, прочитав это как «реестр не
// настроен». У всех сразу.
//
// ── СПРАШИВАЕТ PNPM, А НЕ NPM ───────────────────────────────────────────────
//
// Ставит зависимости pnpm, значит и про доступ надо спрашивать его. Это не
// вкусовщина и не следствие починки предупреждения выше: с 11-й линии у pnpm
// СВОЙ конфиг, которого npm не читает вовсе (`pnpm config set --location=user`
// пишет в `pnpm/auth.ini`, а не в npmrc — замерено на 11.18.0). Гейт на npm
// поэтому умеет отказать тому, у кого всё настроено — по-pnpm'ному, — и пустить
// того, у кого настроено там, куда установка не смотрит. Спрашивать надо того,
// кто пойдёт ставить.
//
// А вот КОМАНДЫ ВОССТАНОВЛЕНИЯ остаются npm'овские, и это не забытая строка:
// читают npmrc обе линии pnpm, а пишет в НАЗВАННЫЙ ФАЙЛ только npm. Скажи мы
// `pnpm config set`, на 11-й линии токен уехал бы в `~/.config/pnpm/auth.ini` —
// мимо тома кредов, то есть не пережил бы пересоздания, ради которого том и
// заведён. Обещание в тексте отказа — контракт, и держится оно пробой, которая
// исполняет эти команды и требует, чтобы стена после них исчезла.
const registryCheck = npmScope && npmScopeIsPrivate && [
  '(',
  `reg=$(${noStore(`pnpm config get ${npmScope}:registry`)});`,
  'case "$reg" in',
  'http*) ;;',
  '*)',
  say(
    q(`Пакеты ${npmScope}/* тянутся из приватного реестра, а он не настроен.`),
    q('Установка пойдёт в npmjs.org и ответит «404, пакета нет» — хотя пакет есть, нет доступа.'),
    q(`Настрой доступ в ${npmrc}:`),
    q(`  npm config set ${npmScope}:registry <адрес-реестра> --location=user`),
    q('  npm config set //<хост-реестра>/:_authToken <токен> --location=user'),
  ),
  '; exit 1;;',
  'esac;',
  'h=${reg#*://}; h=${h%/};',
  // Без `--fetch-retries=0`, который стоял здесь при npm: pnpm такого флага не
  // принимает вовсе (`Unknown option`), а конфигом его `whoami` не слушает —
  // проверено обоими именами и строкой в npmrc. Цена названа: при НЕДОСТУПНОМ
  // реестре с положенным токеном отказ приходит не сразу, а через две попытки
  // pnpm (~70 секунд), и она вслух говорит, чего ждёт. Два ходовых состояния —
  // токена нет и токен протух — как были мгновенными, так и остались.
  `${noStore('pnpm whoami --registry="$reg"')} >/dev/null 2>&1 ||`,
  '{',
  say(
    q(`Реестр для ${npmScope} настроен, а доступа к нему нет: токен не положен или протух.`),
    '"[devbox]   реестр: $reg"',
    '"[devbox]   проверка руками: pnpm whoami --registry=$reg"',
    q(`Положи токен в ${npmrc}:`),
    '"[devbox]   npm config set //$h/:_authToken <токен> --location=user"',
  ),
  '; exit 1; }',
  ')',
].join(' ');

const onCreate = ['sudo corepack enable'];
// ГЛОБАЛЬНЫЙ АССИСТЕНТ ЗОВЁТ NPM НАПРЯМУЮ, И ЭТО ОСТАВЛЕНО НАРОЧНО.
//
// По правилу выше он тоже обязан идти без имени стора: стор ему не нужен, а
// предупреждение он породит то же самое. Одного `noStore` здесь не хватает,
// потому что цена правки лежит ВНЕ зоны: она двигает `onCreateCommand` живого
// `.devcontainer` этого репозитория, а эталон приёмки перекладывает architect
// при выпуске. Взять её молча значило бы уронить приёмку зоны на чужом шаге.
//
// Разница с гейтом не в размере: одноразовая настройка тома против ДВУХ вызовов
// на каждом пересоздании. Заявка потребителя была про второе.
if (installAssistant) onCreate.push('npm install -g @anthropic-ai/claude-code@latest');

const post = [];
// Названная потеря идёт ПЕРВОЙ, а не последней: постсоздание кончается установкой
// зависимостей, и это инвариант зоны — по нему проба отрезает шаг проверки реестра.
// Предупреждение, приписанное в хвост, сместило бы конец и стоило бы этого инварианта.
post.push(toolchainCheck);
if (mountTargets.length) post.push(`sudo chown -R ${owner} ${mountTargets.join(' ')}`);
if (installAssistant) post.push('mkdir -p "$CLAUDE_CONFIG_DIR" && { [ -f "$CLAUDE_CONFIG_DIR/.claude.json" ] || printf \'%s\\n\' \'{"hasCompletedOnboarding":true,"hasTrustDialogAccepted":true,"theme":"dark"}\' > "$CLAUDE_CONFIG_DIR/.claude.json"; }');
// Порядок несущий: креды лежат в томе, права на который выставляет chown выше, а
// проверка обязана стоять ПЕРЕД установкой — иначе она рассказывает про уже
// случившийся невнятный отказ.
if (registryCheck) post.push(registryCheck);
post.push(installCommand);

// Комментарий над шагом собирается из ТЕХ ЖЕ частей, что и сам шаг. Отдельный текст
// про постсоздание разошёлся бы с постсозданием при первой же новой настройке — ровно
// так «БЕЗ biome» пережило появление настройки форматтера.
const postWhat = ['названные потери тулчейна'];
if (mountTargets.length) postWhat.push('права на общие тома');
if (installAssistant) postWhat.push('seed claude-онбординга');
if (registryCheck) postWhat.push('проверка доступа к реестру');
postWhat.push('установка зависимостей');

const list = (items) => items.map((v) => `    ${JSON.stringify(v)}`).join(',\n');
const pairs = (entries) =>
  entries.map(([key, value]) => `    ${JSON.stringify(key)}: ${JSON.stringify(value)}`).join(',\n');

// Комментарий над блоком переменных собирается из тех же частей, что и сам блок.
const envWhat = [];
if (secretsVolume) envWhat.push('секрет-модель');
if (storeDir) envWhat.push('адрес pnpm-стора');
if (env.size > computedEnv.size) envWhat.push('продуктовые переменные');
-%>
{
  // <%- name %> — Ф2 (kb:ADR-16 volume-workspace, kb:FUND-4 containers-only).
  // ГРИНФИЛД на стандартном Dev Containers (adopt-not-invent, kb:ADR-20): upstream-образ +
  // features + native "Clone Repository in Container Volume". БЕЗ skeleton-скриптов
  // (devbox.sh/-manifest/-session/-services) и БЕЗ biome/GH-Packages — это devopser-legacy.
  // Docker-инварианты канон-чистого девбокса сохранены (kb:DEVOPSER-3).
  "name": "<%- name %>",
  "image": "<%- image %>:<%- imageTag %>",
  "remoteUser": "<%- imageUser %>",

<% if (network) { -%>
  // Канон-чистые инварианты (kb:DEVOPSER-3): peer-alias в общей сети <%- network %>
  // (видят tasker/knowledger по имени), host-gateway, НОЛЬ host-портов (single-origin —
  // наружу только дверь :8080; verdaccio :4873 остаётся внутренним), контейнер переживает
  // рестарт демона.
<% } else { -%>
  // host-gateway (виден хост изнутри) и рестарт вместе с демоном — базовые инварианты.
<% } -%>
  "runArgs": [
<%- list(runArgs) %>
  ],

<% if (env.size) { -%>
  // Переменные окружения контейнера: <%- envWhat.join(', ') %>.
<% if (secretsVolume) { -%>
  // Секрет-модель (kb:FUND-4): креды/кэши — в named-volume'ах, ENV указывает в <%- home %>/.secrets.
  // Ничего не хардкодим в образ/репо; тома переживают recreate.
<% } -%>
<% if (storeDir) { -%>
  // Стор pnpm назван ДВУМЯ именами, и это не дубль: до pnpm 11 он читает npm-конфиг
  // (NPM_CONFIG_*), с 11-й — свой (PNPM_CONFIG_*). Без них при воркспейсе-томе pnpm
  // кладёт стор рядом с воркспейсом, а смонтированный том стоит нетронутым.
<% } -%>
  "containerEnv": {
<%- pairs([...env]) %>
  },

<% } -%>
<% if (Object.keys(features).length) { -%>
  // Фичи Dev Containers — настройка devcontainerFeatures. Базовый образ несёт node/pnpm/git
  // (версия pnpm — из пина самого репозитория через corepack; образ = тонкая оболочка),
  // остальные тулчейны приезжают сюда: чего тут нет, того в девбоксе нет, и постсоздание
  // говорит об этом вслух, если репозиторий тулчейн объявил.
  "features": {
<%- pairs(Object.entries(features)) %>
  },

<% } -%>
<% if (mounts.length) { -%>
  // Общие на машине named-volume'ы (одни креды/стор на все omnifield-девбоксы), переживают recreate.
  // Workspace-ТОМ здесь НЕ объявляем: им управляет "Clone Repository in Container Volume"
  // (kb:ADR-16) — VS Code сам создаёт том, клонирует репо, монтирует как workspace. См. runbook.
  "mounts": [
<%- list(mounts) %>
  ],

<% } -%>
  "customizations": {
    "vscode": {
      // Расширения и форматтер — настройки обвеса. Дополняют .vscode/extensions.json репо.
<% if (injectedFormatter) { -%>
      // Форматтер в списке — от обвеса: его значение и есть идентификатор расширения,
      // поэтому ставить его вторым перечислением человеку незачем.
<% } -%>
      "extensions": [<%- extensions.map((e) => JSON.stringify(e)).join(', ') %>],
      "settings": {
<%- editorSettings.map((line) => `        ${line}`).join(',\n') %>
      }
    }
  },

<% if (installAssistant) { -%>
  // Одноразовая (per-volume) настройка: corepack→pnpm-пин + глобальный ассистент
  // (kb:FUND-4 — исполнение/ассистент живут В контейнере, не на хосте).
<% } else { -%>
  // Одноразовая (per-volume) настройка: corepack→pnpm-пин.
<% } -%>
  "onCreateCommand": "<%- onCreate.join(' && ') %>",

  // Репо-зависимая настройка: <%- postWhat.join(', ') %>.
  "postCreateCommand": <%- JSON.stringify(post.join(' && ')) %>
}
