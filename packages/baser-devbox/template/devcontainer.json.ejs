<%
// Слой «настройки» собирается здесь, чтобы ниже читался готовый devcontainer.

// ПОЛЬЗОВАТЕЛЬ ОБРАЗА — ОДИН ИСТОЧНИК ДЛЯ ВСЕГО, ЧТО ОТ НЕГО СЧИТАЕТСЯ.
//
// До 0.4.0 он был прибит к `node` в пяти местах сразу — `remoteUser`, цели томов,
// `containerEnv`, `chown`, текст про креды, — а настройка `image` при этом обещала
// поставить чужой образ. Обещание держалось только для образов, где пользователя
// зовут `node`: у живого девбокса weber он `vscode`, и тома с переменными уехали бы
// в несуществующий домашний каталог, а `chown` упал бы (tasker:BASER2-40).
// Половина настройки хуже её отсутствия (kb:BASER2-2 §5), поэтому источник один.
//
// ДОМАШНИЙ КАТАЛОГ БЕРЁТСЯ ПО СОГЛАШЕНИЮ, и это названная граница, а не догадка:
// `/root` у root, `/home/<имя>` у остальных. Спросить образ обвес не может — он
// кладёт файл, а не запускает контейнер, — а цель тома обязана быть литералом:
// `mounts` разворачивается docker'ом до того, как внутри контейнера существует
// хоть какая-то `$HOME`. Образ, кладущий пользователя иначе, этой настройкой не
// покрыт, и так сказано в её описании.
const home = imageUser === 'root' ? '/root' : `/home/${imageUser}`;
// Группа — одноимённая с пользователем: так его заводят upstream-образы Dev
// Containers (`node`, `vscode`, `codespace`), так же устроен и root.
const owner = `${imageUser}:${imageUser}`;

// НАЗВАННЫЙ ОТКАЗ ОБВЕСА. Своего кода у него нет — коды называет форма, — поэтому
// прогон получает `render-failed` с НАШИМ текстом, и на диск не ложится ничего.
// Это единственный канал, которым инструмент говорит «так нельзя» до применения.
const refuse = (message) => {
  throw new Error(`[devbox] ${message}`);
};

const mounts = [];
if (secretsVolume) mounts.push(`source=${secretsVolume},target=${home}/.secrets,type=volume`);
if (pnpmStoreVolume) mounts.push(`source=${pnpmStoreVolume},target=${home}/.local/share/pnpm/store,type=volume`);
const mountTargets = mounts.map((m) => m.split(',')[1].slice('target='.length));

const runArgs = [];
if (network) runArgs.push(`--network=${network}`, `--network-alias=${networkAlias}`);
runArgs.push('--add-host=host.docker.internal:host-gateway', '--restart=unless-stopped');

// Настройки редактора. Форматтер — РЕГУЛИРОВКА, а не константа: прибитый гвоздями,
// он заставляет потребителя с другим стеком форкать обвес целиком из-за одной строки,
// и это дефект шаблона, а не проблема пользователя (kb:BASER2-2 §5).
// Не задан вовсе (null) — обвес форматирование не навязывает и обе строки не кладёт.
const editorSettings = [];
if (editorFormatter) {
  editorSettings.push('"editor.formatOnSave": true');
  editorSettings.push(`"editor.defaultFormatter": ${JSON.stringify(editorFormatter)}`);
}
// tsdk регулировкой НЕ становится: он указывает на TypeScript САМОГО репозитория, и для
// devbox-образа typescript-node другого верного значения нет.
editorSettings.push('"typescript.tsdk": "node_modules/typescript/lib"');

// ЗАДАННЫЙ ФОРМАТТЕР ОБВЕС ДЕРЖИТ В СПИСКЕ РАСШИРЕНИЙ САМ.
//
// `editor.defaultFormatter` принимает ИДЕНТИФИКАТОР РАСШИРЕНИЯ, поставляющего
// форматтер. Значит «форматтер задан» и «расширение стоит» — одно и то же
// утверждение, и обвес может гарантировать его по построению, а не называть отказом:
// отказ требовал бы действия от человека там, где верный ответ обвесу известен.
// Так класс ошибки (форматтер, которого в контейнере нет) исчезает, а не ловится.
//
// ИСКЛЮЧЕНИЕ — встроенные расширения. Издатель `vscode.` зарезервирован за теми, что
// уже в редакторе (`vscode.json-language-features` и прочие). Их не ставят из
// маркетплейса, и запись в `extensions` для них — не «на всякий случай», а
// несуществующий идентификатор в артефакте, то есть та же тихая неверность с другой
// стороны. Условие сужает правило, а не отменяет: чинить по построению — значит не
// чинить одно, ломая соседнее.
const builtInFormatter = Boolean(editorFormatter) && editorFormatter.startsWith('vscode.');
const injectedFormatter =
  Boolean(editorFormatter) && !builtInFormatter && !editorExtensions.includes(editorFormatter);
const extensions = injectedFormatter ? [...editorExtensions, editorFormatter] : editorExtensions;

// ФИЧИ DEV CONTAINERS — настройка, а не список, прибитый в шаблоне.
//
// Спека девконтейнеров решает тулчейн именно фичами, и шаблон ими уже
// пользовался — но список был прибит, и полиглот-репозиторий не мог добавить
// себе питон, не форкнув обвес из-за одной строки (tasker:BASER2-110). Это ровно
// тот дефект шаблона, что и прибитый форматтер: отсутствие регулировки под
// ходовую нужду — наш брак, а не выбор пользователя (kb:BASER2-7).
//
// Форма — список строк: опции фичи (карта) ею невыразимы намеренно, по одному
// примеру форму не расширяем. Фича приезжает с опциями по умолчанию, и это
// сказано в описании настройки, а не подразумевается.
const features = devcontainerFeatures ?? [];
for (const [index, ref] of features.entries()) {
  if (typeof ref !== 'string' || ref.trim() === '') {
    refuse(`настройка devcontainerFeatures: ${JSON.stringify(ref)} — не ссылка на фичу`);
  }
  if (features.indexOf(ref) !== index) {
    refuse(`настройка devcontainerFeatures: ${JSON.stringify(ref)} названа дважды — в артефакте это один ключ, и второй молча съел бы первый`);
  }
}

// Обе проверки постсоздания говорят одним голосом: строка с ярлыком `[devbox]` в
// stderr. Помощники объявлены здесь, потому что ими пользуются обе.
const say = (...args) => `printf '%s\\n' ${args.join(' ')} >&2`;
const q = (line) => `'[devbox] ${line}'`;

// ЧЕГО ДЕВБОКС НЕ ДАЁТ — НАЗЫВАЕТСЯ ВСЛУХ.
//
// «Девбокс» у нас сегодня значит «НОДОВЫЙ девбокс»: базовый образ несёт
// node/pnpm/git, всё прочее приезжает фичами. Нигде не написанное, это
// обнаруживалось самым дорогим способом — первым `git commit`: репозиторий
// brainer объявляет питон в корне (`.python-version`, `[tool.uv]`, `uv.lock`), его
// nx-таргеты зовут `uv`, а `uv` в девбоксе нет — pre-commit упал на трёх зонах
// сразу, и коммит-каденс продукта встал целиком (tasker:BASER2-109 П1).
//
// Обвес не обязан нести все тулчейны мира — но обязан НАЗВАТЬ расхождение, и
// назвать его фактом с двух концов: объявил ли ТУЛЧЕЙН САМ РЕПОЗИТОРИЙ (файл в
// корне) и есть ли КОМАНДА в контейнере. Отсюда два свойства: проверка молчит у
// того, кто про этот тулчейн не говорил, и замолкает сама, как только нужную
// фичу добавили. Ни списка «поддерживаемых стеков», ни настройки-выключателя:
// нечего выключать там, где нечего и сказать.
const toolchains = [
  {
    what: 'питон',
    declaredBy: '.python-version, pyproject.toml, uv.lock',
    when: '[ -f .python-version ] || [ -f pyproject.toml ] || [ -f uv.lock ]',
    tool: 'python',
  },
  {
    what: 'uv',
    declaredBy: 'uv.lock, [tool.uv] в pyproject.toml',
    when: "[ -f uv.lock ] || grep -qs '^\\[tool.uv\\]' pyproject.toml",
    tool: 'uv',
  },
  // go идёт рядом с питоном не по симметрии: следующие три переезжающих продукта
  // (tasker, knowledger, chater) — все на Go, и класс у них тот же самый.
  {
    what: 'go',
    declaredBy: 'go.mod',
    when: '[ -f go.mod ]',
    tool: 'go',
  },
];
const toolchainCheck = [
  '( lost=;',
  ...toolchains.map((chain) =>
    `if { ${chain.when}; } && ! command -v ${chain.tool} >/dev/null 2>&1; then ` +
    `${say(q(`Репозиторий объявляет ${chain.what} (${chain.declaredBy}), а команды ${chain.tool} в девбоксе нет.`))}; lost=1; fi;`,
  ),
  'if [ -n "$lost" ]; then',
  say(
    q('Девбокс НОДОВЫЙ: базовый образ несёт node/pnpm/git, остальные тулчейны приезжают фичами Dev Containers.'),
    q('Добавь нужные настройкой devcontainerFeatures в файле настроек девбокса и пересоздай контейнер.'),
    q('Каталог фич: https://containers.dev/features'),
    q('Пока их нет — таргеты этого тулчейна упадут, и обычно первым же git commit.'),
  ),
  '; fi )',
].join(' ');

// Куда человеку класть креды. Путь настоящий, а не «куда-нибудь»: обещание в тексте
// отказа — такой же контракт, как код, и непроверенное оно заводит в тупик.
const npmrc = secretsVolume
  ? `${home}/.secrets/npmrc — том, переживает пересоздание контейнера`
  : '~/.npmrc — ВНИМАНИЕ: не переживёт пересоздание контейнера, заведи том с кредами';

// Проверка доступа к приватному реестру ДО установки зависимостей.
// Без неё npm идёт в npmjs.org и отвечает «404, пакета нет» — человек идёт искать
// несуществующий пакет вместо своих кредов. Стена без указателя.
//
// УСЛОВИЙ ДВА, И ОНИ ПРО РАЗНОЕ: есть ли у репозитория scope (`npmScope`) и лежит
// ли он в приватном реестре (`npmScopeIsPrivate`). Раньше состояние было одно —
// «scope задан» — и «публичный scope» выражался ОТСУТСТВИЕМ значения, то есть
// неотличимо от «про scope забыли» (`tasker:BASER2-105`). Цена этой неразличимости
// назначена: в день, когда @omnifield станет публичным (`kb:ADR-19`), пин в
// user-конфиге перестанет быть нужен, `npm config get` вернёт `undefined` — и
// проверка уронила бы ПРАВИЛЬНО настроенный девбокс, прочитав это как «реестр не
// настроен». У всех сразу.
const registryCheck = npmScope && npmScopeIsPrivate && [
  '(',
  `reg=$(npm config get ${npmScope}:registry);`,
  'case "$reg" in',
  'http*) ;;',
  '*)',
  say(
    q(`Пакеты ${npmScope}/* тянутся из приватного реестра, а он не настроен.`),
    q('Установка пойдёт в npmjs.org и ответит «404, пакета нет» — хотя пакет есть, нет доступа.'),
    q(`Настрой доступ в ${npmrc}:`),
    q(`  npm config set ${npmScope}:registry <адрес-реестра> --location=user`),
    q('  npm config set //<хост-реестра>/:_authToken <токен> --location=user'),
  ),
  '; exit 1;;',
  'esac;',
  'h=${reg#*://}; h=${h%/};',
  'npm whoami --registry="$reg" --fetch-retries=0 >/dev/null 2>&1 ||',
  '{',
  say(
    q(`Реестр для ${npmScope} настроен, а доступа к нему нет: токен не положен или протух.`),
    '"[devbox]   реестр: $reg"',
    '"[devbox]   проверка руками: npm whoami --registry=$reg"',
    q(`Положи токен в ${npmrc}:`),
    '"[devbox]   npm config set //$h/:_authToken <токен> --location=user"',
  ),
  '; exit 1; }',
  ')',
].join(' ');

const onCreate = ['sudo corepack enable'];
if (installAssistant) onCreate.push('npm install -g @anthropic-ai/claude-code@latest');

const post = [];
// Названная потеря идёт ПЕРВОЙ, а не последней: постсоздание кончается установкой
// зависимостей, и это инвариант зоны — по нему проба отрезает шаг проверки реестра.
// Предупреждение, приписанное в хвост, сместило бы конец и стоило бы этого инварианта.
post.push(toolchainCheck);
if (mountTargets.length) post.push(`sudo chown -R ${owner} ${mountTargets.join(' ')}`);
if (installAssistant) post.push('mkdir -p "$CLAUDE_CONFIG_DIR" && { [ -f "$CLAUDE_CONFIG_DIR/.claude.json" ] || printf \'%s\\n\' \'{"hasCompletedOnboarding":true,"hasTrustDialogAccepted":true,"theme":"dark"}\' > "$CLAUDE_CONFIG_DIR/.claude.json"; }');
// Порядок несущий: креды лежат в томе, права на который выставляет chown выше, а
// проверка обязана стоять ПЕРЕД установкой — иначе она рассказывает про уже
// случившийся невнятный отказ.
if (registryCheck) post.push(registryCheck);
post.push(installCommand);

// Комментарий над шагом собирается из ТЕХ ЖЕ частей, что и сам шаг. Отдельный текст
// про постсоздание разошёлся бы с постсозданием при первой же новой настройке — ровно
// так «БЕЗ biome» пережило появление настройки форматтера.
const postWhat = ['названные потери тулчейна'];
if (mountTargets.length) postWhat.push('права на общие тома');
if (installAssistant) postWhat.push('seed claude-онбординга');
if (registryCheck) postWhat.push('проверка доступа к реестру');
postWhat.push('установка зависимостей');

const list = (items) => items.map((v) => `    ${JSON.stringify(v)}`).join(',\n');
const pairs = (entries) =>
  entries.map(([key, value]) => `    ${JSON.stringify(key)}: ${JSON.stringify(value)}`).join(',\n');
-%>
{
  // <%- name %> — Ф2 (kb:ADR-16 volume-workspace, kb:FUND-4 containers-only).
  // ГРИНФИЛД на стандартном Dev Containers (adopt-not-invent, kb:ADR-20): upstream-образ +
  // features + native "Clone Repository in Container Volume". БЕЗ skeleton-скриптов
  // (devbox.sh/-manifest/-session/-services) и БЕЗ biome/GH-Packages — это devopser-legacy.
  // Docker-инварианты канон-чистого девбокса сохранены (kb:DEVOPSER-3).
  "name": "<%- name %>",
  "image": "<%- image %>:<%- imageTag %>",
  "remoteUser": "<%- imageUser %>",

<% if (network) { -%>
  // Канон-чистые инварианты (kb:DEVOPSER-3): peer-alias в общей сети <%- network %>
  // (видят tasker/knowledger по имени), host-gateway, НОЛЬ host-портов (single-origin —
  // наружу только дверь :8080; verdaccio :4873 остаётся внутренним), контейнер переживает
  // рестарт демона.
<% } else { -%>
  // host-gateway (виден хост изнутри) и рестарт вместе с демоном — базовые инварианты.
<% } -%>
  "runArgs": [
<%- list(runArgs) %>
  ],

<% if (secretsVolume) { -%>
  // Секрет-модель (kb:FUND-4): креды/кэши — в named-volume'ах, ENV указывает в <%- home %>/.secrets.
  // Ничего не хардкодим в образ/репо; тома переживают recreate.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "<%- home %>/.secrets/claude",
    "GIT_CONFIG_GLOBAL": "<%- home %>/.secrets/gitconfig",
    "GH_CONFIG_DIR": "<%- home %>/.secrets/gh",
    "NPM_CONFIG_USERCONFIG": "<%- home %>/.secrets/npmrc"
  },

<% } -%>
<% if (features.length) { -%>
  // Фичи Dev Containers — настройка devcontainerFeatures. Базовый образ несёт node/pnpm/git
  // (версия pnpm — из пина самого репозитория через corepack; образ = тонкая оболочка),
  // остальные тулчейны приезжают сюда: чего тут нет, того в девбоксе нет, и постсоздание
  // говорит об этом вслух, если репозиторий тулчейн объявил.
  "features": {
<%- pairs(features.map((ref) => [ref, {}])) %>
  },

<% } -%>
<% if (mounts.length) { -%>
  // Общие на машине named-volume'ы (одни креды/стор на все omnifield-девбоксы), переживают recreate.
  // Workspace-ТОМ здесь НЕ объявляем: им управляет "Clone Repository in Container Volume"
  // (kb:ADR-16) — VS Code сам создаёт том, клонирует репо, монтирует как workspace. См. runbook.
  "mounts": [
<%- list(mounts) %>
  ],

<% } -%>
  "customizations": {
    "vscode": {
      // Расширения и форматтер — настройки обвеса. Дополняют .vscode/extensions.json репо.
<% if (injectedFormatter) { -%>
      // Форматтер в списке — от обвеса: его значение и есть идентификатор расширения,
      // поэтому ставить его вторым перечислением человеку незачем.
<% } -%>
      "extensions": [<%- extensions.map((e) => JSON.stringify(e)).join(', ') %>],
      "settings": {
<%- editorSettings.map((line) => `        ${line}`).join(',\n') %>
      }
    }
  },

<% if (installAssistant) { -%>
  // Одноразовая (per-volume) настройка: corepack→pnpm-пин + глобальный ассистент
  // (kb:FUND-4 — исполнение/ассистент живут В контейнере, не на хосте).
<% } else { -%>
  // Одноразовая (per-volume) настройка: corepack→pnpm-пин.
<% } -%>
  "onCreateCommand": "<%- onCreate.join(' && ') %>",

  // Репо-зависимая настройка: <%- postWhat.join(', ') %>.
  "postCreateCommand": <%- JSON.stringify(post.join(' && ')) %>
}
