#!/bin/sh
# МАШИННЫЙ pre-commit — артефакт обвеса `@omnifield/baser-git`.
#
# Файл принадлежит поставке целиком (`regenerated`): правка руками не переживёт
# следующего применения. Что он гоняет — настройка `verifyCommand` в файле
# настроек обвеса; всё остальное здесь одинаково у всех и не регулируется.
#
# ── ПОЧЕМУ ХУК ВООБЩЕ ЛЕЖИТ ТУТ, А НЕ В РЕПОЗИТОРИИ ──────────────────────────
#
# `.git/hooks/` — папка, в которую git смотрит САМ, без единой настройки. Хук,
# положенный в версионируемую папку, требует `core.hooksPath`, а это локальная
# настройка каждого клона: обвес её не выставляет (действий он не привозит) и
# просить о ней докой уже пробовали — так и появилась `tasker:BASER2-195`.
#
# Цена названа честно: файл НЕ версионируется и в свежий клон приезжает не с
# `git clone`, а с применением обвеса. Ровно этим применение и занимается.
#
# ── ПОЧЕМУ ОДНА КОМАНДА, А НЕ СПИСОК ────────────────────────────────────────
#
# Готовность локации — её собственное дело и её собственное имя. Обвес не знает
# ни менеджера пакетов, ни имён задач, и список шагов здесь был бы вторым местом,
# где живёт то же самое: локация уже описала свою готовность у себя.
set -e
exec <%- verifyCommand %>
