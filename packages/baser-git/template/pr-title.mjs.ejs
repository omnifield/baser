<%
// Перечень зон приезжает списком либо не приезжает вовсе. Пустой список и
// незаполненная настройка — одно и то же состояние («перечень открыт»), и
// разводить их значило бы завести различие, которого нет ни в одном правиле
// ниже: зона из пустого перечня не бывает ни годной, ни негодной.
const scopes = Array.isArray(titleScopes) ? titleScopes.filter((name) => String(name).trim() !== '') : [];
const closed = scopes.length > 0;
-%>
#!/usr/bin/env node
/**
 * ГЕЙТ ЗАГОЛОВКА PR: заголовок обязан быть сообщением коммита в главную ветку.
 *
 * **Файл кладёт обвес `@omnifield/baser-git`.** Правка руками не переживёт
 * следующее применение — правило настраивается настройками обвеса
 * (`titleTypes` · `titleScopeRequired` · `titleScopes`), а не этим файлом.
 *
 * Сквош-мерж уносит в историю ЗАГОЛОВОК PR, а не коммиты внутри ветки. По нему
 * считалка версий выводит номер выпуска и changelog, а заголовок без типа не
 * поднимет версию вовсе; `!` внутри тела сквоша мажор тоже не сделает — его
 * ищут в первой строке. Значит заголовок это не подпись, а вход выпуска.
 *
 * ПОЧЕМУ ЭТО ФАЙЛ, А НЕ `grep` В YAML. Правило в строке воркфлоу проверяется
 * только живым прогоном на живом PR — то есть после того, как ошибку уже
 * сделали. Здесь то же правило кодом: ломающая правка краснеет пробами обвеса,
 * а не заголовком, уехавшим в главную.
 *
 * ЗАВИСИМОСТЕЙ НЕТ И ЭТО СВОЙСТВО. Гейт стоит на КАЖДОЙ правке заголовка и
 * обязан отвечать секундами: его джоб — `checkout` + `setup-node` + запуск, без
 * установки зависимостей. Значит он не стоит в очереди за реестром и токенами и
 * не краснеет от чужой недоступности.
 *
 * ```
 * PR_TITLE='feat(cli): дверь достаёт поставку' node .github/scripts/pr-title.mjs
 * ```
 *
 * Выход `0` — заголовок годен, `1` — не годен и причина названа.
 */

import { pathToFileURL } from 'node:url';

/**
 * Типы, которые мы признаём. Список закрытый: незнакомый тип считалка версий
 * молча пропустит мимо выпуска, а не отвергнет.
 */
export const TYPES = <%- JSON.stringify(titleTypes) %>;

/** Обязана ли быть названа зона. */
export const SCOPE_REQUIRED = <%- titleScopeRequired ? 'true' : 'false' %>;

/**
 * Закрытый перечень зон; `null` — перечень открыт, годится любая по форме.
 */
export const SCOPES = <%- closed ? JSON.stringify(scopes) : 'null' %>;

/**
 * Форма заголовка: `<тип>(<зона>)!: <что сделано>`.
 *
 * Разобрана по частям намеренно. Одно сплошное выражение отвечает только «да»
 * или «нет», а человеку нужно знать, ЧТО именно не так: у гейта нет другого
 * способа сказать это, кроме как разложить заголовок на части и назвать ту,
 * которая не сошлась.
 */
const FORM =
  /^(?<type>[A-Za-z][A-Za-z0-9]*)(?:\((?<scope>[^()]*)\))?(?<breaking>!)?: (?<subject>.+)$/;

/** Зона — строчные латинские, цифры и дефис: она же имя зоны продукта. */
const SCOPE = /^[a-z0-9-]+$/;

/**
 * Годен ли заголовок и, если нет, — чем именно.
 *
 * Пробелы по краям срезаются: они не тот дефект, ради которого гейт заведён, а
 * красный гейт на невидимом символе учит обходить гейт, а не писать заголовки.
 *
 * @param {string} title заголовок PR как его прислал GitHub
 * @returns {{ok: boolean, problem?: string}}
 */
export function judge(title) {
  const value = String(title ?? '').trim();

  if (value === '') return { ok: false, problem: 'заголовок пуст' };

  const parts = FORM.exec(value)?.groups;
  if (parts === undefined) {
    return {
      ok: false,
      problem: 'форма не разобрана — нет пары «<тип>(<зона>): » в начале',
    };
  }

  const { type, scope } = parts;

  if (!TYPES.includes(type)) {
    return {
      ok: false,
      problem: `тип «${type}» не из списка (${TYPES.join(' · ')})`,
    };
  }

  if (scope === undefined) {
    return SCOPE_REQUIRED
      ? { ok: false, problem: 'зона не названа — по ней видно, чьё изменение' }
      : { ok: true };
  }

  if (!SCOPE.test(scope)) {
    return {
      ok: false,
      problem: `зона «${scope}» не по форме: строчные латинские, цифры и дефис`,
    };
  }

  // Перечень зон судится ПОСЛЕ формы: «Cli» — это не «зоны такой нет», а
  // неверно написанная зона, и сказать человеку надо именно это.
  if (SCOPES !== null && !SCOPES.includes(scope)) {
    return {
      ok: false,
      problem: `зоны «${scope}» нет среди зон локации (${SCOPES.join(' · ')})`,
    };
  }

  return { ok: true };
}

/**
 * Подсказка человеку — не «неверный формат», а что писать вместо.
 *
 * Живёт рядом с правилом и пробуется вместе с ним: подсказка, разошедшаяся с
 * правилом, хуже её отсутствия — по ней исправляют заголовок и получают второй
 * красный.
 *
 * @returns {string[]}
 */
export function hint() {
  // Образец обязан САМ проходить гейт, поэтому зона в нём — настоящая, а не
  // `<зона>`: человек правит заголовок ПО ОБРАЗЦУ, и образец, который гейт не
  // пропускает, отправляет его на второй красный. Отсюда же две строки, а не
  // одна: вторая показывает пометку ломающего на живом примере.
<% if (closed) { -%>
  const first = SCOPES[0];
  const second = SCOPES[1] ?? SCOPES[0];
<% } else { -%>
  // Перечень открыт — имени зоны локации мы не знаем и не выдумываем его:
  // `core` в образце подписан как заполнитель прямо ниже.
  const first = 'core';
  const second = 'core';
<% } -%>
  const breaking = TYPES.includes('feat') ? 'feat' : TYPES[0];

  const lines = [
    'Мы мержим сквошем — этот заголовок станет коммитом в главной ветке, и по',
    'нему считалка версий выводит номер выпуска и changelog. Без типа изменение',
    'останется невидимым для выпуска, а ломающее не поднимет мажор.',
    '',
    'Форма: <тип>(<зона>): <что сделано> — например',
    `  ${TYPES[0]}(${first}): что сделано, одной фразой`,
    `  ${breaking}(${second})!: ломающее помечается восклицательным знаком`,
<% if (!closed) { -%>
    '',
    'Вместо «core» подставь свою зону: по ней видно, чьё изменение.',
<% } -%>
    '',
    `Типы: ${TYPES.join(' · ')}`,
  ];

  if (SCOPES !== null) {
    lines.push(`Зоны: ${SCOPES.join(' · ')}`);
  }
  if (SCOPE_REQUIRED) {
    lines.push('Зона обязательна — по ней видно, чьё изменение.');
  }

  lines.push(
    '',
    'Правка заголовка перезапускает эту проверку сама (событие edited):',
    'исправил — и жди зелёного, пуш для этого не нужен.',
  );

  return lines;
}

/**
 * Запуск в конвейере.
 *
 * Заголовок приходит ПЕРЕМЕННОЙ ОКРУЖЕНИЯ, а не подстановкой `${{ }}` в текст
 * команды, и это не стиль: подстановка склеивает заголовок с телом скрипта, то
 * есть отдаёт автору PR выполнение команд на нашем раннере.
 */
function main() {
  const title = process.env.PR_TITLE ?? '';
  const { ok, problem } = judge(title);

  if (ok) {
    console.log(`Заголовок в порядке: ${title}`);
    return 0;
  }

  console.log(
    `::error::Заголовок PR не по Conventional Commits: «${title}» — ${problem}`,
  );
  console.log('');
  for (const line of hint()) console.log(line);
  return 1;
}

if (
  process.argv[1] &&
  import.meta.url === pathToFileURL(process.argv[1]).href
) {
  process.exit(main());
}
