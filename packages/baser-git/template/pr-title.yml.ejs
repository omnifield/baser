name: PR title

# ФАЙЛ КЛАДЁТ ОБВЕС `@omnifield/baser-git` — правки затираются при следующем
# применении. Версия Node приезжает настройкой `nodeVersion`, само правило —
# настройками `titleTypes` · `titleScopeRequired` · `titleScopes`.
#
# ОТДЕЛЬНЫЙ ФАЙЛ — ИЗ-ЗА СОБЫТИЙ, А НЕ ИЗ-ЗА ОПРЯТНОСТИ.
#
# Типы событий задаются на ВЕСЬ workflow, а не на задачу. Гейт заголовка обязан
# перезапускаться на правку заголовка (`edited`) — иначе человек, исправивший его
# по подсказке гейта, зелёного не получит и будет искать, чем перезапустить.
# Дописать `edited` к потоку приёмки значило бы гонять на каждую правку
# заголовка И весь тяжёлый набор — установку, сборку и пробы. Значит у гейта своё
# событие, а у него — свой файл.
#
# `synchronize` здесь ОБЯЗАТЕЛЕН, и это не дубль. Проверка привязана к SHA: на
# новом пуше у нового коммита проверки этого имени нет вовсе, и обязательный
# контекст держал бы PR закрытым навсегда.
#
# СВЕРКА С РЫНКОМ (2026-08-05). Смотрел `amannn/action-semantic-pull-request` —
# де-факто стандарт для conventional-заголовка на сквош-мерже. Нашёл: рекомендует
# ОТДЕЛЬНЫЙ workflow с ровно этим набором типов (`opened`, `reopened`, `edited`,
# `synchronize`) и прямо предупреждает, что без `synchronize` обязательная
# проверка не переедет на новый пуш. Форму берём — она сходится с нашим разбором.
# Само действие НЕ берём: правило обвеса строже спецификации (зона обязательна —
# по ней видно, чьё изменение), подсказка называет зоны локации, а джоб гейта
# держится zero-deps намеренно. Тянуть стороннее действие ради проверки, которая
# у нас уже есть и покрыта пробами, — плата правами и цепочкой поставки без
# выигрыша.
on:
  pull_request:
    types: [opened, edited, synchronize, reopened]

# Заголовок берётся из полезной нагрузки события — ни репозитория, ни API гейту
# не нужно. Право на чтение содержимого нужно только шагу `checkout`.
permissions:
  contents: read

jobs:
  # ИМЯ ЗАДАЧИ = ИМЯ ОБЯЗАТЕЛЬНОГО КОНТЕКСТА в правиле влития. Переименуешь —
  # контекст в правиле перестанет находиться, и гейт молча выключится: PR будет
  # вливаться, не дождавшись проверки, которой нет.
  pr-title:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: <%- nodeVersion %>
      # Заголовок идёт ПЕРЕМЕННОЙ ОКРУЖЕНИЯ. Подстановка `${{ }}` в текст команды
      # склеила бы заголовок PR с телом скрипта — это выполнение команд на нашем
      # раннере по воле автора PR.
      - name: Заголовок PR — по Conventional Commits
        env:
          PR_TITLE: ${{ github.event.pull_request.title }}
        run: node .github/scripts/pr-title.mjs
