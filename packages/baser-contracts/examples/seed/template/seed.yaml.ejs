# seed.yaml — заготовка, которую дальше ведёт человек.
#
# Класс `placed-once`: станок кладёт файл в объявленном месте и больше не
# трогает. Правка руками расхождением не считается, флага не поднимает и затёрта
# не будет.
owner: <%- owner %>
areas:
<% for (const area of areas) { -%>
  - <%- area %>
<% } -%>
