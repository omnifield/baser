{
  "name": "@omnifield/baser-contracts",
  "version": "0.3.0-dev.1",
  "description": "Хвостовик baser: форма, которой обвес объявляет себя станку — раскладка, класс артефакта, настройки и пресеты",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@omnifield/baser-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locate": {
      "@omnifield/baser-source": "./src/locate.ts",
      "types": "./dist/locate.d.ts",
      "import": "./dist/locate.js",
      "default": "./dist/locate.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
