{
  "name": "@omnifield/baser-materialize",
  "version": "0.0.2",
  "description": "Движок baser: раскладывает объявленное и обновляет разложенное — план, применение, владение паспортом укладки",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
