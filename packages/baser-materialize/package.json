    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nx/devkit": "^23.0.0"
  },
  "devDependencies": {
    "@nx/devkit": "23.1.0"
  },
  "publishConfig": {
