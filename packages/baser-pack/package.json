{
  "name": "@omnifield/baser-pack",
  "version": "0.0.2",
  "description": "Проверенный обвес, нормализованный и с манифестом выдачи: обвес подходит посадочному месту — значит собран к выдаче",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@omnifield/baser-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@omnifield/baser-check": "workspace:*",
    "@omnifield/baser-contracts": "workspace:*",
    "tslib": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
